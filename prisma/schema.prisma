generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @default("")
  password     String   @default("")
  role         String   @default("customer")  // customer, vendor, rider
  area         String   @default("")
  avatar       String   @default("")
  onboardingComplete Boolean @default(false)

  // Vendor fields
  storeName         String?
  businessCategory  String?
  businessAddress   String?
  bankName          String?
  accountNumber     String?
  openTime          String   @default("08:00")
  closeTime         String   @default("22:00")

  // Rider fields
  vehicleType       String?
  plateNumber       String?
  licenseNumber     String?
  vehicleColor      String?
  riderBankName     String?
  riderAccountNumber String?

  // Loyalty
  hasanatPoints     Int      @default(5400)
  swiftPoints       Int      @default(1200)
  loyaltyTier       String   @default("gold")
  dailyStreak       Int      @default(3)

  // Wallet & Financial
  walletBalance    Int      @default(0)   // in kobo
  vendorStatus     String   @default("active")  // active, suspended, pending
  riderStatus      String   @default("active")  // active, suspended, pending

  // Referral
  referralCode     String   @default("")  // e.g. SWIFT-A3X9K2

  // Spin wheel state
  lastSpinDate      String   @default("")
  spinStreak        String   @default("")

  // State
  riderOnline       Boolean  @default(false)
  vendorOnline      Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders        Order[]
  cartItems     CartItem[]
  notifications Notification[]

  // New relations
  wishlist        WishlistItem[]
  addresses       Address[]
  reviews         Review[]
  payments        Payment[]
  following       Follow[]        @relation("UserFollows")
  followers       Follow[]        @relation("UserFollowers")
  savedVideos     SavedVideo[]
  chatMessages    ChatMessage[]
  setting         UserSetting?
  vendorProducts  Product[]       @relation("VendorProducts")
  walletTxns      WalletTransaction[]
  payouts         Payout[]
  refunds         Refund[]
  kycDocuments    KYCDocument[]
  supportTickets  SupportTicket[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  price        Int      @default(0)
  salePrice    Int?
  originalPrice Int?
  image        String   @default("")
  images       String   @default("[]")
  category     String   @default("meals")
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  deliveryTime String   @default("30 min")
  inStock      Boolean  @default(true)
  vendorId     String?
  vendor       User?    @relation("VendorProducts", fields: [vendorId], references: [id])
  productReviews Review[]
  createdAt    DateTime @default(now())
}

model Order {
  id        String   @id @default(cuid())
  status    String   @default("Preparing")
  total     Int      @default(0)
  riderName String?
  items     String   @default("[]")
  progress  Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  payments  Payment[]
  orderReviews Review[]

  @@index([userId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(cuid())
  productId String
  name      String
  price     Int
  image     String   @default("")
  quantity  Int      @default(1)
  sessionId String   @default("default")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Smart Kitchen: Pantry Items (owner-scoped) ──
model PantryItem {
  id          String   @id @default(cuid())
  ownerEmail  String   @default("guest")
  name        String
  category    String   @default("other")  // produce, dairy, grain, protein, spice, other
  quantity    String   @default("1")
  unit        String   @default("pcs")
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Smart Kitchen: Cooking Sessions (analytics + gamification) ──
model CookingSession {
  id           String   @id @default(cuid())
  ownerEmail   String   @default("guest")
  recipeName   String
  difficulty   String   @default("medium")  // easy, medium, hard
  durationSec  Int      @default(0)
  completed    Boolean  @default(false)
  usedLiveAI   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ── Community: Posts & Comments (owner-scoped) ──
model CommunityPost {
  id         String   @id @default(cuid())
  authorName String
  authorInitial String @default("U")
  authorEmail String  @default("guest")
  category   String   @default("General")  // Reviews, Recipes, Tips, Questions, General
  content    String
  imageUrl   String?
  likes      Int      @default(0)
  likedBy    String   @default("[]")  // JSON array of emails
  createdAt  DateTime @default(now())
  comments   CommunityComment[]
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  authorInitial String @default("U")
  authorEmail String  @default("guest")
  content   String
  createdAt DateTime @default(now())
}

// ── Reels: TikTok-style short videos ──
model Video {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  videoUrl     String
  thumbnailUrl String   @default("")
  authorName   String
  authorHandle String   @default("")
  authorAvatar String   @default("")
  category     String   @default("cooking") // cooking, iftar, sahur, tips, reviews
  duration     Int      @default(0)         // seconds
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  views        Int      @default(0)
  likedBy      String   @default("[]")      // JSON array of viewer emails
  authorId     String?
  createdAt    DateTime @default(now())
  videoComments VideoComment[]
  savedBy       SavedVideo[]
}

model VideoComment {
  id            String   @id @default(cuid())
  videoId       String
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  authorName    String
  authorHandle  String   @default("")
  authorAvatar  String   @default("")
  content       String
  likes         Int      @default(0)
  createdAt     DateTime @default(now())
}

// ── Wishlist: saved products per user ──
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  name      String
  price     Int
  image     String   @default("")
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ── Saved delivery addresses ──
model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String   @default("Home")
  address      String
  area         String   @default("")
  city         String   @default("Lagos")
  instructions String   @default("")
  lat          Float?
  lng          Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Reviews: products, riders, vendors ──
model Review {
  id           String   @id @default(cuid())
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id])
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  authorName   String
  authorAvatar String   @default("")
  rating       Int      @default(5)
  comment      String   @default("")
  images       String   @default("[]")
  targetType   String   @default("product") // product, rider, vendor
  targetId     String?
  createdAt    DateTime @default(now())
}

// ── Coupons / promo codes ──
model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  type       String   @default("percent") // percent, fixed
  value      Int      @default(10)
  minOrder   Int      @default(0)
  maxUses    Int      @default(1000)
  uses       Int      @default(0)
  validUntil DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ── Payments ──
model Payment {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  amount    Int
  method    String   @default("card") // card, transfer, cash, bnpl
  status    String   @default("pending") // pending, success, failed, refunded
  reference String   @unique
  provider  String   @default("paystack")
  createdAt DateTime @default(now())
}

// ── Follow / subscribe ──
model Follow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User     @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
}

// ── Saved / bookmarked videos ──
model SavedVideo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}

// ── Direct chat messages (rider↔customer↔vendor) ──
model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id])
  senderName String
  senderRole String   @default("customer")
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([roomId])
}

// ── User settings ──
model UserSetting {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationsEnabled Boolean  @default(true)
  pushEnabled          Boolean  @default(true)
  emailEnabled         Boolean  @default(false)
  language             String   @default("en")
  currency             String   @default("NGN")
  theme                String   @default("dark")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId])
}

// ── Wallet Transactions ──
model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // topup, payment, refund, payout, cashback
  amount      Int      // in kobo (positive = credit, negative = debit)
  balance     Int      // balance after transaction in kobo
  description String   @default("")
  reference   String   @default("")  // external reference (paystack ref, etc.)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ── Payouts (vendor/rider withdrawals) ──
model Payout {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int      // in kobo
  status        String   @default("pending")  // pending, processing, completed, failed, rejected
  bankName      String   @default("")
  accountNumber String   @default("")
  accountName   String   @default("")
  reference     String   @unique
  adminNote     String   @default("")
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ── Refunds ──
model Refund {
  id            String   @id @default(cuid())
  orderId       String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int      // in kobo
  reason        String   @default("")
  status        String   @default("requested")  // requested, approved, processing, completed, rejected
  refundMethod  String   @default("original")  // original, wallet
  reference     String   @unique
  adminNote     String   @default("")
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── KYC Documents ──
model KYCDocument {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    String   // national_id, voters_card, drivers_license, international_passport, nin
  documentNumber  String   @default("")
  status          String   @default("pending")  // pending, verified, rejected
  documentImage   String   @default("")  // base64 encoded image
  rejectionReason String   @default("")
  verifiedBy      String?  // admin user id
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Support Tickets ──
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   @default("general")  // general, order, payment, delivery, account, vendor, rider
  subject   String
  status    String   @default("open")  // open, in_progress, resolved, closed
  priority  String   @default("medium")  // low, medium, high, urgent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  TicketMessage[]

  @@index([userId])
}

// ── Ticket Messages ──
model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String?
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}
