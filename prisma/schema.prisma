generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @default("")
  password     String   @default("")
  role         String   @default("customer")  // customer, vendor, rider
  area         String   @default("")
  avatar       String   @default("")
  onboardingComplete Boolean @default(false)

  // Vendor fields
  storeName         String?
  businessCategory  String?
  businessAddress   String?
  bankName          String?
  accountNumber     String?
  openTime          String   @default("08:00")
  closeTime         String   @default("22:00")

  // Rider fields
  vehicleType       String?
  plateNumber       String?
  licenseNumber     String?
  vehicleColor      String?
  riderBankName     String?
  riderAccountNumber String?

  // Loyalty
  hasanatPoints     Int      @default(5400)
  swiftPoints       Int      @default(1200)
  loyaltyTier       String   @default("gold")
  dailyStreak       Int      @default(3)

  // State
  riderOnline       Boolean  @default(false)
  vendorOnline      Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders     Order[]
  cartItems  CartItem[]
  notifications Notification[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  price        Int      @default(0)
  salePrice    Int?
  originalPrice Int?
  image        String   @default("")
  images       String   @default("[]")
  category     String   @default("meals")
  rating       Float    @default(0)
  reviews      Int      @default(0)
  deliveryTime String   @default("30 min")
  inStock      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Order {
  id        String   @id @default(cuid())
  status    String   @default("Preparing")
  total     Int      @default(0)
  riderName String?
  items     String   @default("[]")
  progress  Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  productId Int
  name      String
  price     Int
  image     String   @default("")
  quantity  Int      @default(1)
  sessionId String   @default("default")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
