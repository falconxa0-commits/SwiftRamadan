# ─────────────────────────────────────────────────────────────────────────────
# SwiftRamadan — environment variable template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values. `.env` is git-ignored; this template
# is the canonical list of env vars consumed by the app.
#
# Conventions:
#  - Empty values (`""`) mean "feature disabled" — most integrations fail-open
#    or no-op when their env vars are blank.
#  - Values marked `REQUIRED in production` MUST be set before `bun run start`
#    in production. Missing them won't crash boot (the app has fallbacks) but
#    the corresponding subsystem will be degraded.
#  - `NEXT_PUBLIC_*` vars are exposed to the browser — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# Database ────────────────────────────────────────────────────────────────────
# Choose ONE of the two DATABASE_URL forms below. The active `prisma/schema.prisma`
# pins `provider = "sqlite"` for local dev; `prisma/schema.postgresql.prisma` is
# the PostgreSQL variant that `scripts/migrate-to-postgres.sh` swaps in.
#
# SQLite (default — local dev; file is created on first `bun run db:push`):
DATABASE_URL="file:./db/custom.db"
# PostgreSQL (production — matches the `postgres` service in docker-compose.yml):
# DATABASE_URL="postgresql://swiftramadan:${POSTGRES_PASSWORD}@postgres:5432/swiftramadan?schema=public"

# PostgreSQL (production) ─────────────────────────────────────────────────────
# Consumed by docker-compose.yml's `postgres` service (POSTGRES_USER /
# POSTGRES_PASSWORD) and the `app` service's `DATABASE_URL`. `DB_PASSWORD` is
# the legacy name still written by `scripts/bootstrap-production.sh` — keep it
# in sync with `POSTGRES_PASSWORD` until that script is migrated.
POSTGRES_USER=""
POSTGRES_PASSWORD=""

# Auth ─────────────────────────────────────────────────────────────────────────
# REQUIRED in production — signs JWTs for sessions. Generate with:
#   `openssl rand -base64 32`
APP_SECRET="your-jwt-secret-here"
# Legacy alias used by `src/lib/auth-jwt.ts` as a fallback if APP_SECRET is unset.
# Set both to the same value to avoid surprises during the migration window.
NEXTAUTH_SECRET=""

# Redis ───────────────────────────────────────────────────────────────────────
# Two backends supported (see `src/lib/redis.ts`):
#   1. Upstash cloud (REST/HTTPS) — preferred for serverless / Vercel.
#   2. Standard Redis (`redis://...`) — used by docker-compose's `redis:7-alpine`.
# Both can be set; Upstash wins if both are populated. If neither is set, an
# in-memory Map is used (single-process dev only — NOT multi-instance safe).
#
# Upstash cloud — get these from https://console.upstash.com/redis:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
#
# Standard Redis (Docker) — `REDIS_URL` is the full connection string; the
# `:password@` segment is the standard Redis URL convention for password-only
# auth. `REDIS_PASSWORD` is consumed by `docker-compose.yml` (the `redis`
# service's `--requirepass` and the `app` service's `REDIS_URL`).
REDIS_URL=""
REDIS_PASSWORD=""

# Payments ─────────────────────────────────────────────────────────────────────
# Paystack — https://dashboard.paystack.com/api/settings/keys
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Flutterwave — https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""
# Monnify — https://apps.monnify.com/ (API keys under "API Keys")
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
# OPay — https://merchant.opayweb.com/developer/api-keys
OPAY_MERCHANT_ID=""
OPAY_PUBLIC_KEY=""
OPAY_SECRET_KEY=""
# Moniepoint — https://dashboard.moniepoint.com/
MONIEPOINT_API_KEY=""
MONIEPOINT_SECRET_KEY=""
# BNPL providers — Carbon, CredPal
CARBON_API_KEY=""
CREDDIT_API_KEY=""

# Communications ──────────────────────────────────────────────────────────────
# Resend (email) — https://resend.com/api-keys
RESEND_API_KEY=""
# Termii (SMS) — https://developers.termii.com/
TERMII_API_KEY=""
TERMII_SENDER_ID=""
# Twilio (SMS / Voice) — https://console.twilio.com/
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# WhatsApp Business Cloud API — https://developers.facebook.com/docs/whatsapp
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_VERIFY_TOKEN=""

# Maps ────────────────────────────────────────────────────────────────────────
# Google Maps Platform — enable "Geocoding API", "Distance Matrix API",
# "Directions API", "Places API" at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# OAuth ───────────────────────────────────────────────────────────────────────
# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple — https://developer.apple.com/account/resources/identifiers/list
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Monitoring ──────────────────────────────────────────────────────────────────
# Sentry — https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Analytics — exposed to the browser (`NEXT_PUBLIC_*`)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_MIXPANEL_TOKEN=""

# CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated origin allowlist (matches `src/middleware.ts`).
# Example: "https://swiftramadan.com,https://www.swiftramadan.com"
CORS_ALLOWED_ORIGINS=""

# Public app URL (used by payment callbacks / wallet receipts) ─────────────────
APP_URL=""
NEXT_PUBLIC_APP_URL=""

# Storage (uploads / videos) ──────────────────────────────────────────────────
# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
# Cloudflare Stream — https://dash.cloudflare.com/?to=/:account/stream
CF_STREAM_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""

# Supabase (auth/storage if used; currently a stub in `src/lib/supabase.ts`) ──
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Identity verification (BVN/NIN) ────────────────────────────────────────────
# Prembly / Smile Identity / Youverify — pick one based on the route's logic.
PREMBLY_API_KEY=""
SMILE_IDENTITY_API_KEY=""
YOUVERIFY_API_KEY=""
IDENTITY_VERIFICATION_API_KEY=""
IDENTITY_VERIFICATION_URL=""

# External APIs ───────────────────────────────────────────────────────────────
# Aladhan prayer-times API — defaults to the public endpoint if unset.
ALADHAN_API_BASE=""

# AI ──────────────────────────────────────────────────────────────────────────
# z-ai-web-dev-sdk uses built-in credentials (no env vars required).
# Token budgets + per-user rate limits live in `src/ai/limits.ts`.

# Docker compose overrides ────────────────────────────────────────────────────
# These are interpolated by `docker-compose.yml` at compose-time (not by the
# Next.js app). Override on the host (e.g. via your shell or a `.env` file
# next to `docker-compose.yml`) to customise the containerised stack.
#
# PostgreSQL credentials — prefer POSTGRES_USER / POSTGRES_PASSWORD (above).
# `DB_PASSWORD` is the legacy name still written by
# `scripts/bootstrap-production.sh` and read as a fallback by
# `docker-compose.yml` (so an old bootstrap-generated `.env` keeps working).
# Set BOTH to the same value during the migration window; if only one is set,
# docker-compose prefers POSTGRES_PASSWORD.
DB_PASSWORD="changeme"
REDIS_PASSWORD="swiftramadan2026"
